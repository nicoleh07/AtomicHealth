# Keep secrets here on the Python server, never in frontend variables.
DATABASE_PATH=data/health-twin.sqlite3
SEED_DEMO=true
APP_ORIGIN=http://127.0.0.1:5174
# Optional Claude chat + image/PDF report extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# An OAuth access token supplied by your existing Python Oura integration.
OURA_ACCESS_TOKEN=
# Optional: Python module in which get_provider(provider_id) returns an adapter.
HEALTH_TWIN_PROVIDER_MODULE=
# Set to true only when you deliberately allow private .env configuration to send data to Claude.
AI_ENABLED=false
